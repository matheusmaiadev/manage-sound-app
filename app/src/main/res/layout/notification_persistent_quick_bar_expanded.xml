<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quick_bar_root_expanded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/quick_bar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notif_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Som + Vibrar • Perfil Trabalho" />

    <TextView
        android:id="@+id/quick_bar_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/notif_text_secondary"
        android:textSize="12sp"
        tools:text="Toque 80% • Notif 75% • Mídia 50%" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/bg_notif_capsule_track"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/quick_bar_btn_sound"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_pill_sound_active"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/quick_bar_icon_sound"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_volume_up" />

                <TextView
                    android:id="@+id/quick_bar_label_sound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:textColor="@color/notif_sound_active_fg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Som" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_bar_btn_silent"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:id="@+id/quick_bar_icon_silent"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_silent" />

                <TextView
                    android:id="@+id/quick_bar_label_silent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:maxLines="1"
                    android:textColor="@color/notif_pill_inactive_fg"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Silêncio" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quick_bar_btn_vibrate"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_pill_vibrate_active"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/quick_bar_icon_vibrate"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_vibration" />

            <TextView
                android:id="@+id/quick_bar_label_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/notif_vibrate_active_fg"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Vibrar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
